# Copy to .env and set the LAN IP of the machine running the backend.
# Consumed with: flutter run --dart-define-from-file=.env
#
#   Emulator          http://10.0.2.2:8080
#   Physical device   http://<LAN-IP>:8080    (e.g. http://192.168.1.110:8080)
#   USB tunnel        http://localhost:8080   (after adb reverse tcp:8080 tcp:8080)
API_BASE_URL=http://192.168.1.110:8080
