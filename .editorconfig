root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,yml,yaml,json,ts,tsx,js,jsx}]
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
indent_size = 4
end_of_line = crlf

[Makefile]
indent_style = tab
