# Create a free-tier key at https://aistudio.google.com/api-keys
# Keep the real key in .env.local (ignored by Git), never in Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_ATTEMPT_SECONDS=20
# Optional independent vision fallback, after the primary Gemini model.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
